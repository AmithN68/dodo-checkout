{
  "name": "dodo-checkout",
  "private": true,
  "version": "0.1.0",
  "description": "Embeddable checkout: SDK, checkout app, and demo store.",
  "type": "module",
  "scripts": {
    "predev": "npm run build:sdk",
    "dev": "vite",
    "prebuild": "npm run build:sdk",
    "build": "tsc -b && vite build",
    "build:sdk": "vite build --config vite.sdk.config.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
